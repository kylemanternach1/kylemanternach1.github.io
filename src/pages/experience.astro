---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Experience | ${SITE_TITLE}`} description="Work experience and background." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Experience</h1>
			<p>Replace these placeholders with your real roles, dates, and highlights.</p>

			<section>
				<h2>Role title — Company</h2>
				<p class="meta">2023 – Present · City, ST</p>
				<ul>
					<li>What you owned or shipped</li>
					<li>Impact or outcome worth mentioning</li>
					<li>Tools or skills relevant to this role</li>
				</ul>
			</section>

			<section>
				<h2>Earlier role — Company</h2>
				<p class="meta">2020 – 2023 · City, ST</p>
				<ul>
					<li>Another highlight from this role</li>
					<li>Something that shows growth or range</li>
				</ul>
			</section>

			<section>
				<h2>Education</h2>
				<p class="meta">Degree · School · Year</p>
				<p>Optional note about focus, honors, or coursework.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		margin-top: 2.5em;
	}
	.meta {
		margin-top: -0.5em;
		color: rgb(var(--gray));
	}
</style>
