			<path d="M26 20 14 32l12 12" />
			<path d="M38 20 50 32 38 44" />
			<path d="M36 16 28 48" />
		</svg>
	)
}
{
	name === 'product' && (
		<svg viewBox="0 0 64 64" aria-hidden="true">
			<rect x="16" y="14" width="32" height="38" rx="4" />
			<path d="M26 14.5v-2a6 6 0 0 1 12 0v2" />
			<path d="M24 30h16" />
			<path d="M24 38h16" />
			<path d="M24 46h10" />
		</svg>
	)
}
{
	name === 'systems' && (
		<svg viewBox="0 0 64 64" aria-hidden="true">
			<path d="M32 24 18 44M32 24l14 20M22 46h20" />
			<circle cx="32" cy="18" r="6" />
			<circle cx="16" cy="48" r="6" />
			<circle cx="48" cy="48" r="6" />
