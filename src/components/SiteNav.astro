---
import { navLinks } from '../data/site';

const homePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const onHome = Astro.url.pathname === homePath || Astro.url.pathname === homePath.slice(0, -1);
const blogPath = `${homePath}blog`;
---

<header class="site-nav">
	<button class="theme-toggle" type="button" aria-label="Switch to dark mode">
		<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
			<path
				fill="currentColor"
				d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
		</svg>
		<svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
			<g stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M12 2.4v2.4"></path>
				<path d="M12 19.2v2.4"></path>
				<path d="M2.4 12h2.4"></path>
				<path d="M19.2 12h2.4"></path>
				<path d="M5.21 5.21l1.7 1.7"></path>
				<path d="M17.09 17.09l1.7 1.7"></path>
				<path d="M18.79 5.21l-1.7 1.7"></path>
				<path d="M6.91 17.09l-1.7 1.7"></path>
			</g>
		</svg>
	</button>

	<nav>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-label="Open menu">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<ul>
			{
				navLinks.map((link) => (
					<li>
						<a href={onHome ? `#${link.id}` : `${homePath}#${link.id}`}>{link.title}</a>
					</li>
				))
			}
			<li>
				<a
					href={blogPath}
					aria-current={
						Astro.url.pathname === blogPath || Astro.url.pathname.startsWith(`${blogPath}/`)
							? 'page'
							: undefined
					}
					>Blog</a
				>
			</li>
		</ul>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.querySelector('.theme-toggle');
	const menuButton = document.querySelector('.menu-toggle');
	const menu = document.querySelector('.site-nav ul');

	function syncThemeButton() {
		const dark = root.dataset.theme === 'dark';
		toggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
	}

	syncThemeButton();

	toggle?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		localStorage.setItem('theme', next);
		syncThemeButton();
	});

	menuButton?.addEventListener('click', () => {
		const open = menuButton.getAttribute('aria-expanded') === 'true';
		menuButton.setAttribute('aria-expanded', String(!open));
		menu?.classList.toggle('open', !open);
		menuButton.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menu.classList.remove('open');
			menuButton?.setAttribute('aria-expanded', 'false');
			menuButton?.setAttribute('aria-label', 'Open menu');
		});
	});

	let scrollFrame = 0;
	let scrollTimer = 0;

	function cancelScroll() {
		cancelAnimationFrame(scrollFrame);
		clearTimeout(scrollTimer);
	}

	function onNextFrame(callback: (now: number) => void) {
		let ran = false;
		const run = (now: number) => {
			if (ran) return;
			ran = true;
			cancelAnimationFrame(scrollFrame);
			clearTimeout(scrollTimer);
			callback(now);
		};
		scrollFrame = requestAnimationFrame(run);
		scrollTimer = window.setTimeout(() => run(performance.now()), 32);
	}

	function animateScroll(targetY: number) {
		cancelScroll();
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			window.scrollTo(0, targetY);
			return;
		}

		const start = window.scrollY;
		const distance = targetY - start;
		if (Math.abs(distance) < 1) return;

		const duration = Math.min(900, Math.max(480, Math.abs(distance) * 0.45));
		const started = performance.now();

		const step = (now: number) => {
			const progress = Math.min(1, (now - started) / duration);
			const eased =
				progress < 0.5
					? 4 * progress * progress * progress
					: 1 - Math.pow(-2 * progress + 2, 3) / 2;
			window.scrollTo(0, start + distance * eased);
			if (progress < 1) onNextFrame(step);
		};

		onNextFrame(step);
	}

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

		const link = event.target.closest('a[href^="#"]');
		if (!link) return;

		const id = link.getAttribute('href')?.slice(1);
		if (!id) return;

		const target = document.getElementById(id);
		if (!target) return;

		event.preventDefault();
		const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
		const top = target.getBoundingClientRect().top + window.scrollY - margin;
		history.pushState(null, '', `#${id}`);
		animateScroll(top);
	});
</script>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.5rem;
		background: #f2f0ef;
	}

	:global(html[data-theme='dark']) .site-nav {
		background: #000;
	}

	.theme-toggle,
	.menu-toggle {
		border: 0;
		background: transparent;
		color: #111;
		cursor: pointer;
		padding: 0.4rem;
	}

	:global(html[data-theme='dark']) .theme-toggle,
	:global(html[data-theme='dark']) .menu-toggle {
		color: #f2f0ef;
	}

	.theme-toggle svg {
		display: block;
		width: 28px;
		height: 28px;
	}

	.theme-toggle .icon-sun {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-toggle .icon-moon {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-toggle .icon-sun {
		display: block;
	}

	nav ul {
		display: flex;
		gap: 2.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		color: #36454f;
		font-size: 1.05rem;
		font-weight: 500;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: #111;
	}

	:global(html[data-theme='dark']) nav a {
		color: #828282;
	}

	:global(html[data-theme='dark']) nav a:hover,
	:global(html[data-theme='dark']) nav a[aria-current='page'] {
		color: #f2f0ef;
	}

	.menu-toggle {
		display: none;
		width: 40px;
		height: 40px;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
	}

	.menu-toggle span {
		display: block;
		height: 2px;
		width: 22px;
		background: currentColor;
	}

	@media (max-width: 720px) {
		.menu-toggle {
			display: flex;
		}

		nav ul {
			display: none;
			position: absolute;
			top: 4.2rem;
			right: 1rem;
			flex-direction: column;
			gap: 1rem;
			min-width: 160px;
			padding: 1.25rem 1.5rem;
			border-radius: 12px;
			background: linear-gradient(to right, #f2f0ef, #dcd9d3);
		}

		:global(html[data-theme='dark']) nav ul {
			background: linear-gradient(to right, #434343, #000);
		}

		nav ul.open {
			display: flex;
		}
	}
</style>
